# Copy to .env and fill in. .env itself is gitignored — never commit real secrets.

# --- LLM provider (pick one; Ollama Cloud is this workspace's default) ---
OLLAMA_API_KEY=
# ANTHROPIC_API_KEY=
# FOIA_LLM_PROVIDER=            # "ollama-cloud" | "anthropic" | "fake" — forces the choice

# --- LinkedIn scraper (vendor/linkedin_scraper) — now needed ONLY for linkedin_jobs ---
# Snov.io has no job-postings API, so job search is the one LinkedIn tool still driven by
# the vendored Scrapy spider. Sign up free at https://scrapeops.io/app/register/main.
# Free tier: 1,000 credits/mo, 30 credits/LinkedIn request (~33 free requests/mo).
# When unset (or out of credits) linkedin_jobs returns an error result — NOT a silent empty.
SCRAPEOPS_API_KEY=

# --- Serper (Google SERP search backend for web_search) ---
# Get a key at https://serper.dev. Search only — page fetching is Crawl4AI now, so no
# scrape endpoint is used. When unset, web_search degrades to an empty/error result.
# Accepts a COMMA-SEPARATED LIST for multi-key rotation. Rotation triggers on credit
# exhaustion, which Serper reports as HTTP 400 "Not enough credits" (not 429) — see
# app/tools/keyrotation.py. Check a key's balance at https://google.serper.dev/account.
SERPER_API_KEY=
# SERPER_BASE_URL=https://google.serper.dev   # override only if using a proxy/enterprise endpoint

# --- SEC EDGAR ---
# SEC blocks requests without a real contact email in the User-Agent.
EDGAR_USER_AGENT=FO-Intelligence-Agent your-real-email@example.com

# --- Snov.io (replaced Hunter.io for email + the LinkedIn scraper for people/company) ---
# Backs linkedin_people_profile, linkedin_company_profile, linkedin_lookup's enrichment
# tier, and enrichment wave 1's principal_email discovery (app/tools/snov.py).
# Auth is an OAuth2 client_credentials PAIR, not a bare API key: create them under
# Account -> API in https://app.snov.io/api-setting. When unset, every Snov.io lookup
# returns an error result with no HTTP call, and email discovery falls back to the free
# site-scrape/JSON-LD tiers only.
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
# SNOV_BASE_URL=https://api.snov.io       # override only if using a proxy endpoint
# FOIA_SNOV_RATE_PER_SEC=1.0              # Snov.io documents 60 req/min; 1/s stays under it
