# Copy to .env and fill in. .env itself is gitignored — never commit real secrets.

# --- LLM provider (pick one; Ollama Cloud is this workspace's default) ---
OLLAMA_API_KEY=
# ANTHROPIC_API_KEY=
# FOIA_LLM_PROVIDER=            # "ollama-cloud" | "anthropic" | "fake" — forces the choice

# --- LinkedIn scraper (vendor/linkedin_scraper) — optional, tier-2 escalation only ---
# Sign up free at https://scrapeops.io/app/register/main (needs email/phone verification).
# Free tier: 1,000 credits/mo, 30 credits/LinkedIn request (~33 free requests/mo).
SCRAPEOPS_API_KEY=

# --- Serper (Google SERP search backend for web_search + page scrape for fetch_page) ---
# Get a key at https://serper.dev — this is the Google-SERP search backend for web_search
# and the scrape backend for fetch_page. When unset, both degrade to an empty/error result.
SERPER_API_KEY=
# SERPER_BASE_URL=https://google.serper.dev   # override only if using a proxy/enterprise endpoint
# SERPER_SCRAPE_URL=https://scrape.serper.dev  # override only if using a proxy/enterprise endpoint

# --- SEC EDGAR ---
# SEC blocks requests without a real contact email in the User-Agent.
EDGAR_USER_AGENT=FO-Intelligence-Agent your-real-email@example.com

# --- Hunter.io (email domain search for enrichment wave 1, app/tools/hunter.py) ---
# Get a free key at https://hunter.io — free tier: 50 credits/month. When unset,
# email discovery degrades to the free site-scrape/JSON-LD tiers only, no Hunter spend.
HUNTER_API_KEY=
