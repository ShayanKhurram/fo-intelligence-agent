# Copy to `.env.local` and fill in. Never commit the filled version.

# Postgres + pgvector connection string (Supabase, Neon, or local Docker pgvector).
# Local dev example: postgresql://postgres:postgres@localhost:5432/micro_rag
# Supabase (transaction pooler recommended for serverless):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Ollama Cloud API key — powers the single answer-generation call (lib/ollama.ts).
OLLAMA_API_KEY=

# Optional model overrides (defaults: gemma4:31b for the "cheapest" and "mid" tiers — a
# non-reasoning model kept as the rollback path; glm-5.2 for the "strongest" tier, used for
# answer generation). The "strongest" tier (glm-5.2) is a reasoning model; its chain-of-thought
# is emitted in a sibling `reasoning` field and excluded by reading only `content` — see
# lib/ollama.ts and lib/ollama.test.ts.
# OLLAMA_MODEL_CHEAPEST=gemma4:31b
# OLLAMA_MODEL_MID=gemma4:31b
# OLLAMA_MODEL_STRONGEST=glm-5.2
